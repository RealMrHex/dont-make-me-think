---
import Button from '../ui/button.astro';
import Link from '../ui/link.astro';
---

<div
    x-data="{ show: !localStorage.getItem('cookieConsent') }"
    x-show="show"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 translate-y-4"
    class="fixed sm:bottom-4 sm:left-4 sm:max-w-sm w-full sm:w-auto left-0 bottom-0 p-4 bg-white border-t sm:border border-gray-200 sm:rounded-lg shadow-lg z-50 text-sm"
    role="dialog"
    aria-labelledby="cookie-notice"
>
<div class="flex-1 space-y-3">
    <div>
        <p id="cookie-notice" class="text-gray-900 font-medium">
            استفاده از کوکی‌ها
        </p>
        <p class="text-gray-600 mt-1">
            ما از کوکی‌ها برای بهبود تجربه‌ی شما و تحلیل نحوه‌ی استفاده از وبسایت استفاده می‌کنیم.
            <Link 
                href="/privacy" 
                variant="underline" 
                size="sm" 
                class="inline-flex"
                aria-label="مشاهده سیاست حریم خصوصی و جزئیات استفاده از کوکی‌ها"
            >
                جزئیات بیشتر
            </Link>
        </p>
    </div>
    <div class="flex flex-wrap gap-2">
        <Button
            size="sm"
            @click="localStorage.setItem('cookieConsent', 'true'); show = false"
            aria-label="پذیرفتن استفاده از کوکی‌ها"
        >
            قبول می‌کنم
        </Button>
        <Button
            size="sm"
            variant="ghost"
            @click="show = false"
            aria-label="رد کردن استفاده از کوکی‌ها"
        >
            نمی‌پذیرم
        </Button>
    </div>
</div>
</div> 