---
import type { Episode } from '../../types/content';
import Link from '../ui/link.astro';

interface Props {
    episode: Episode;
}

const { episode } = Astro.props;
const href = episode.status === 'published' ? `/episodes/${episode.slug}` : null;
---

{href ? (
    <Link 
        href={href}
        class="block group relative"
        transition:name={`episode-${episode.slug}`}
    >
        <article class="relative overflow-hidden border border-gray-200 transition-all duration-200 hover:border-gray-300 hover:shadow-sm cursor-pointer">
            <!-- Content -->
            <div class="relative h-48 border-b border-gray-200 overflow-hidden bg-white">
                <div class="relative h-full flex items-center justify-center z-10">
                    <h2 class="text-2xl font-bold text-gray-900 text-center [text-wrap:balance] group-hover:text-gray-800 px-6 bg-white/90 py-4 rounded-lg shadow-sm">
                        {episode.title}
                    </h2>
                </div>
            </div>
            
            <div class="relative p-6">
                <div class="flex items-center gap-3 text-sm text-gray-600 mb-4 [&_svg]:stroke-gray-400">
                    <div class="flex items-center gap-1.5">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                        <span>فصل {episode.number}</span>
                    </div>
                    <span class="text-gray-300">&bull;</span>
                    {episode.status === 'published' ? (
                        <time datetime={episode.publishedAt} class="flex items-center gap-1.5">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            {episode.publishedAt}
                        </time>
                    ) : (
                        <span class="inline-flex items-center border border-yellow-200 bg-yellow-50/30 px-2 py-0.5 text-xs text-yellow-800">
                            به‌زودی
                        </span>
                    )}
                    <span class="text-gray-300">&bull;</span>
                    <div class="flex items-center gap-1.5">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                        </svg>
                        {episode.topicsCount} مطلب
                    </div>
                </div>

                <p class="text-gray-600 mb-4 line-clamp-2 group-hover:text-gray-700">
                    {episode.description}
                </p>

                {episode.tags && episode.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                        {episode.tags.map(tag => (
                            <span class="inline-flex items-center border border-gray-200 bg-gray-50/30 px-2 py-0.5 text-xs text-gray-600">
                                {tag}
                            </span>
                        ))}
                    </div>
                )}
            </div>
        </article>
    </Link>
) : (
    <article class="relative overflow-hidden border border-gray-200 cursor-default">
        <!-- Content -->
        <div class="relative h-48 border-b border-gray-200 overflow-hidden bg-white">
            <div class="relative h-full flex items-center justify-center z-10">
                <h2 class="text-2xl font-bold text-gray-900 text-center [text-wrap:balance] px-6 bg-white/90 py-4 rounded-lg shadow-sm">
                    {episode.title}
                </h2>
            </div>
        </div>
        
        <div class="relative p-6">
            <div class="flex items-center gap-3 text-sm text-gray-600 mb-4 [&_svg]:stroke-gray-400">
                <div class="flex items-center gap-1.5">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                    <span>فصل {episode.number}</span>
                </div>
                <span class="text-gray-300">&bull;</span>
                {episode.status === 'published' ? (
                    <time datetime={episode.publishedAt} class="flex items-center gap-1.5">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        {episode.publishedAt}
                    </time>
                ) : (
                    <span class="inline-flex items-center border border-yellow-200 bg-yellow-50/30 px-2 py-0.5 text-xs text-yellow-800">
                        به‌زودی
                    </span>
                )}
                <span class="text-gray-300">&bull;</span>
                <div class="flex items-center gap-1.5">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                    {episode.topicsCount} مطلب
                </div>
            </div>

            <p class="text-gray-600 mb-4 line-clamp-2">
                {episode.description}
            </p>

            {episode.tags && episode.tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                    {episode.tags.map(tag => (
                        <span class="inline-flex items-center border border-gray-200 bg-gray-50/30 px-2 py-0.5 text-xs text-gray-600">
                            {tag}
                        </span>
                    ))}
                </div>
            )}
        </div>
    </article>
)} 