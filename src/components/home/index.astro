---
const sections = [
    {
        id: "about",
        title: "چرا این کتاب؟",
        content: `<p>«مرا به فکر وادار نکن» کتابی است که پس از سال‌ها تجربه در زمینه‌ی مشاوره‌ی کاربردپذیری نوشته شده است. استیو کروگ در این کتاب نشان می‌دهد که چطور می‌توان محصولات دیجیتال را برای استفاده آسان‌تر کرد.</p>
        <p>این کتاب تاکنون بیش از ۷۰۰,۰۰۰ نسخه فروش داشته و به ۱۵ زبان ترجمه شده است. امروزه به عنوان مهم‌ترین منبع برای آشنایی با تجربه‌ی کاربری (UX) شناخته می‌شود.</p>`
    },
    {
        id: "why",
        title: "چرا این کتاب محبوب است؟",
        content: `<ul>
            <li>کوتاه و مختصر است. می‌توانید در چند ساعت آن را از ابتدا تا انتها بخوانید</li>
            <li>پر از تصاویر و مثال‌های کاربردی است</li>
            <li>تقریباً در هر صفحه یک نکته‌ی مفید و کاربردی دارد</li>
            <li>نقطه‌ی شروع عالی است. بسیاری از متخصصان UX با خواندن این کتاب مسیر شغلی‌شان را پیدا کرده‌اند</li>
            <li>مثل یک کتاب فنی خشک نیست و خواندنش لذت‌بخش است</li>
        </ul>`
    },
    {
        id: "who",
        title: "این کتاب برای چه کسانی است؟",
        content: `<ul>
            <li>توسعه‌دهندگان و طراحان (رابط کاربری، تعامل و بصری)</li>
            <li>مدیران محصول، رهبران تیم‌های چابک</li>
            <li>نویسندگان، ویراستاران و بازاریابان</li>
            <li>مدیران عامل و تصمیم‌گیرندگان</li>
            <li>دانشجویان و علاقه‌مندان به طراحی</li>
            <li>هر کسی که در ساخت محصولات دیجیتال نقش دارد</li>
        </ul>`
    },
    {
        id: "scope",
        title: "محدوده‌ی کتاب چیست؟",
        content: `<p>این کتاب در نسخه‌ی اول (سال ۲۰۰۰) بر روی وبسایت‌ها تمرکز داشت، چون در آن زمان بیشتر افراد مشغول ساخت وبسایت بودند.</p>
        
        <p>اما در نسخه‌ی سوم، محدوده گسترده‌تر شده و نشان می‌دهد که این اصول برای هر چیزی که مردم استفاده می‌کنند کاربرد دارد:</p>
        
        <ul>
            <li>وبسایت‌ها</li>
            <li>اپلیکیشن‌های موبایل</li>
            <li>نرم‌افزارهای دسکتاپ</li>
            <li>ارائه‌های پاورپوینت</li>
            <li>و حتی برگه‌های رأی‌گیری!</li>
        </ul>`
    }
];

import Link from '../ui/link.astro';
import Button from '../ui/button.astro';
---

<article class="container">
    <!-- Hero Section -->
    <header class="text-center mb-16">
        <h1 class="text-4xl font-bold mb-6">مرا به فکر وادار نکن</h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            رویکردی مبتنی بر عقل سلیم به کاربردپذیری وب (و موبایل)
            <br/>
            <span class="text-lg text-gray-500">ترجمه و آموزش بصری کتاب Don't Make Me Think</span>
        </p>
    </header>

    <div class="max-w-4xl mx-auto">
        <!-- Table of Contents -->
        <nav class="mb-12 p-6 bg-gray-50 rounded-lg">
            <h2 class="text-lg font-bold mb-4">فهرست مطالب</h2>
            <ul class="space-y-2 list-none p-0">
                {sections.map((section) => (
                    <li>
                        <Link 
                            href={`#${section.id}`}
                            variant="muted"
                        >
                            {section.title}
                        </Link>
                    </li>
                ))}
            </ul>
        </nav>

        <!-- Main Content -->
        <div class="prose prose-lg prose-gray max-w-none space-y-16">
            {sections.map((section) => (
                <section id={section.id} class="scroll-mt-8">
                    <h2>{section.title}</h2>
                    <div set:html={section.content} />
                </section>
            ))}
        </div>

        <!-- Call to Action -->
        <section class="text-center py-8 mt-16 border-t border-gray-100">
            <h2 class="text-2xl font-bold mb-4">آماده‌ای شروع کنی؟</h2>
            <p class="text-gray-600 mb-6">
                بیا با هم این کتاب رو به زبان ساده یاد بگیریم!
            </p>
            <Button 
                href="/episodes" 
                variant="primary"
                size="lg"
            >
                شروع یادگیری
            </Button>
        </section>
    </div>
</article>