---
import '../styles/global.css';
import { SEO } from 'astro-seo';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/header/index.astro';
import Footer from '../components/footer/index.astro';
import CookieBanner from '../components/cookie-banner/index.astro';
import Link from '../components/ui/link.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = "مرا به فکر وادار نکن",
	description = "آموزش بصری کتاب «مرا به فکر وادار نکن» به زبان ساده",
	image = "/favicon.svg"
} = Astro.props;

const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="fa" dir="rtl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter fallback="swap" />
		<SEO
			title={title}
			description={description}
			openGraph={{
				basic: {
					title,
					type: "website",
					image,
				},
				image: {
					alt: "Website screenshot",
				},
				optional: {
					description,
					locale: "fa_IR",
				},
			}}
			twitter={{
				creator: "@panicdevs",
				card: "summary_large_image",
				title,
				description,
				image,
			}}
			extend={{
				meta: [
					{
						name: "theme-color",
						content: "#ffffff",
					},
				],
			}}
		/>
	</head>
	<body class="app-wrapper w-full h-full min-h-svh flex flex-col">
		<Header transition:persist transition:name="header" />
		<main 
			class="py-6 app flex-grow flex flex-col items-center"
			transition:animate="slide"
		>
			<div class="w-full flex flex-col items-center" transition:animate="fade">
				<slot />
			</div>
		</main>
		<Footer transition:persist transition:name="footer" />
		<CookieBanner transition:persist transition:name="cookie-banner" />

		{isDev && (
			<button
				id="debug-reset"
				class="fixed bottom-4 left-4 px-4 py-2 bg-red-600 text-white rounded-lg shadow-lg hover:bg-red-700 transition-colors z-50 text-sm font-medium"
				title="Reset all progress and activity data"
			>
				Reset Data
			</button>
		)}
	</body>
</html>

<script>
	// Only include in development
	if (import.meta.env.DEV) {
		document.getElementById('debug-reset')?.addEventListener('click', () => {
			// Clear all localStorage data
			localStorage.clear();
			
			// Reload the page to reinitialize everything
			window.location.reload();
		});
	}
</script>
