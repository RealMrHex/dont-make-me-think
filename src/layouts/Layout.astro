---
import '../styles/global.css';
import { SEO } from 'astro-seo';
import Header from '../components/header/index.astro';
import Footer from '../components/footer/index.astro';
import CookieBanner from '../components/cookie-banner/index.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = "نذار فکر کنم!",
	description = "آموزش بصری کتاب «نذار فکر کنم» به زبان ساده",
	image = "/favicon.svg"
} = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<SEO
			title={title}
			description={description}
			openGraph={{
				basic: {
					title,
					type: "website",
					image,
				},
				image: {
					alt: "Website screenshot",
				},
				optional: {
					description,
					locale: "fa_IR",
				},
			}}
			twitter={{
				creator: "@panicdevs",
				card: "summary_large_image",
				title,
				description,
				image,
			}}
			extend={{
				meta: [
					{
						name: "theme-color",
						content: "#ffffff",
					},
				],
			}}
		/>
	</head>
	<body class="app-wrapper w-full h-full min-h-svh flex flex-col">
		<Header/>
		<main class="py-6 app flex-grow flex flex-col items-center">
			<slot />
		</main>
		<Footer/>
		<CookieBanner />
	</body>
</html>
