---
import '../styles/global.css';
import { SEO } from 'astro-seo';
import { ClientRouter } from 'astro:transitions';

interface Props {
    title?: string;
    description?: string;
    image?: string;
}

const {
    title = "یادگیری تعاملی | مرا به فکر وادار نکن",
    description = "یادگیری تعاملی و گام به گام اصول طراحی تجربه‌ی کاربری",
    image = "/favicon.svg"
} = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <ClientRouter fallback="swap" />
        <SEO
            title={title}
            description={description}
            openGraph={{
                basic: {
                    title,
                    type: "website",
                    image,
                },
                image: {
                    alt: "Website screenshot",
                },
                optional: {
                    description,
                    locale: "fa_IR",
                },
            }}
            extend={{
                meta: [
                    {
                        name: "theme-color",
                        content: "#ffffff",
                    },
                ],
            }}
        />
    </head>
    <body class="min-h-svh bg-gray-50">
        <main class="w-full h-full">
            <slot />
        </main>
    </body>
</html> 