---
import Layout from '../../../layouts/Layout.astro';
import Link from '../../../components/ui/link.astro';
import { getEpisodesOrder, getEpisodeDetails, getTopicDetails, getAllTopicsForEpisode, getTopicComponent, getNextItem, getPrevItem, getNavigationLabel, getNavigationUrl } from '../../../utils/content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
    const slugs = await getEpisodesOrder();
    const paths = [];
    
    for (const episodeSlug of slugs) {
        const episode = await getEpisodeDetails(episodeSlug);
        if (!episode || episode.status !== 'published') continue;

        const topics = await getAllTopicsForEpisode(episodeSlug);
        for (const topic of topics) {
            paths.push({
                params: { 
                    number: episodeSlug,
                    topic: topic.slug 
                },
                props: { episode, topic }
            });
        }
    }
    
    return paths;
}) satisfies GetStaticPaths;

const { number, topic: topicSlug } = Astro.params;
const { episode, topic } = Astro.props;

// Get next and previous items
const nextItem = await getNextItem(number, topicSlug);
const prevItem = await getPrevItem(number, topicSlug);

const TopicComponent = (await getTopicComponent(number, topicSlug))?.default;
---

<Layout 
    title={`${topic.title} | ${episode.title} | مرا به فکر وادار نکن`}
    description={topic.description}
>
    <article class="container">
        <div class="max-w-4xl mx-auto">
            <!-- Breadcrumb -->
            <div class="flex items-center justify-between mb-8" transition:animate="fade">
                <nav class="flex items-center gap-2 text-sm text-gray-500">
                    <Link href="/episodes" variant="muted">فصل‌ها</Link>
                    <span class="text-gray-300">/</span>
                    <Link href={`/episodes/${number}`} variant="muted">{episode.title}</Link>
                    <span class="text-gray-300">/</span>
                    <span class="text-gray-900">{topic.title}</span>
                </nav>
                <Link 
                    href={`/episodes/${number}`}
                    variant="muted"
                    class="flex items-center gap-2 group text-sm"
                >
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                    بازگشت به فصل
                </Link>
            </div>

            <!-- Content -->
            <div class="prose prose-lg prose-gray max-w-none" transition:animate="fade">
                <h1 class="text-4xl font-bold mb-4">{topic.title}</h1>
                <p class="text-xl text-gray-600 mb-8">{topic.description}</p>
                
                {TopicComponent ? (
                    <TopicComponent />
                ) : (
                    <p class="text-red-600">Could not load topic content.</p>
                )}
            </div>

            <!-- Navigation -->
            <nav class="flex items-center justify-between mt-16 pt-8 border-t border-gray-100">
                <div class="flex-1 flex items-center">
                    {prevItem && (
                        <Link 
                            href={getNavigationUrl(prevItem)}
                            variant="muted"
                            class="flex items-center gap-2 group"
                        >
                            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                            <div class="flex flex-col items-start">
                                <span class="text-sm text-gray-500">{getNavigationLabel(prevItem, 'prev')}</span>
                                <span>{prevItem.title}</span>
                            </div>
                        </Link>
                    )}
                </div>
                <div class="flex-1 flex items-center justify-end">
                    {nextItem && (
                        <Link 
                            href={getNavigationUrl(nextItem)}
                            variant="muted"
                            class="flex items-center gap-2 group text-left"
                        >
                            <div class="flex flex-col items-end">
                                <span class="text-sm text-gray-500">{getNavigationLabel(nextItem, 'next')}</span>
                                <span>{nextItem.title}</span>
                            </div>
                            <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                            </svg>
                        </Link>
                    )}
                </div>
            </nav>
        </div>
    </article>
</Layout> 