---
import Layout from '../../layouts/Layout.astro';
import EpisodeCard from '../../components/episode/card.astro';
import { getEpisodesOrder, getEpisodeDetails } from '../../utils/content';

const slugs = await getEpisodesOrder();
const episodes = (await Promise.all(
    slugs.map(async (slug) => await getEpisodeDetails(slug))
)).filter((episode): episode is NonNullable<typeof episode> => episode !== null);

// Clear previous console logs in dev mode
if (import.meta.env.DEV) {
    console.clear();
    console.log('=== Episode List Debug Info ===');
    episodes.forEach(episode => {
        console.log(`Episode: ${episode.slug}`);
        console.log(`- Title: ${episode.title}`);
        console.log(`- Status: ${episode.status}`);
        console.log(`- Topics: ${episode.topicsCount}`);
        console.log('------------------------');
    });
}
---

<Layout 
    title="فصل‌ها | مرا به فکر وادار نکن"
    description="فصل‌های کتاب مرا به فکر وادار نکن"
>
    <div class="container">
        <header class="text-center mb-16" transition:animate="fade">
            <h1 class="text-4xl font-bold mb-4">فصل‌های کتاب</h1>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                در این بخش می‌توانید تمام فصل‌های کتاب را مطالعه کنید.
                هر فصل شامل مثال‌های کاربردی و تمرین‌های عملی است.
            </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" transition:animate="fade">
            {episodes.map((episode) => (
                <EpisodeCard episode={episode} />
            ))}
        </div>
    </div>
</Layout>

<script>
    // Add client-side debug logging
    if (import.meta.env.DEV) {
        const progress = localStorage.getItem('user_progress');
        console.log('=== LocalStorage Debug Info ===');
        console.log('User Progress:', progress ? JSON.parse(progress) : 'Not found');
        console.log('------------------------');
    }
</script> 